POSTGRES_DB=music_platform
POSTGRES_USER=music_app
POSTGRES_PASSWORD=replace_with_local_password

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# RustFS web console http://127.0.0.1:9001/rustfs/console/ - login RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY
RUSTFS_ACCESS_KEY=chime-admin
RUSTFS_SECRET_KEY=replace_with_secret_key
# S3 API endpoint as seen by the application (host:port).
# Use "storage:9000" instead when the app itself runs in Docker Compose.
RUSTFS_ENDPOINT=127.0.0.1:9000
RUSTFS_SECURE=false
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET_MEDIA=music-media


KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8088
DEBEZIUM_PORT=8083

# ClickHouse web UI http://127.0.0.1:8123/play - login CLICKHOUSE_USER / CLICKHOUSE_PASSWORD
CLICKHOUSE_DB=chime_dwh
CLICKHOUSE_USER=chime
CLICKHOUSE_PASSWORD=replace_with_clickhouse_password
CLICKHOUSE_HTTP_PORT=8123

# Grafana http://127.0.0.1:3001 - login GRAFANA_ADMIN_USER / GRAFANA_ADMIN_PASSWORD
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password

# PostgreSQL web UI (pgweb, read-only, no login) http://127.0.0.1:8081
PGWEB_PORT=8081
