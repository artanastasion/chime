POSTGRES_DB=music_platform
POSTGRES_USER=music_app
POSTGRES_PASSWORD=replace_with_local_password

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

RUSTFS_ACCESS_KEY=replace_with_access_key
RUSTFS_SECRET_KEY=replace_with_secret_key
# S3 API endpoint as seen by the application (host:port).
# Use "storage:9000" instead when the app itself runs in Docker Compose.
RUSTFS_ENDPOINT=127.0.0.1:9000
RUSTFS_SECURE=false
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET_MEDIA=music-media

