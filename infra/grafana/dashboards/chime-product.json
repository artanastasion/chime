    {
      "type": "barchart",
      "title": "Discovery funnel",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT step, events FROM (\n    SELECT 1 AS n, 'track view' AS step, countIf(event_type = 'track_view') AS events FROM fact_app_events WHERE $__timeFilter(occurred_at)\n    UNION ALL SELECT 2, 'play started', countIf(event_type = 'play_start') FROM fact_app_events WHERE $__timeFilter(occurred_at)\n    UNION ALL SELECT 3, 'played to end', countIf(event_type = 'play_complete') FROM fact_app_events WHERE $__timeFilter(occurred_at)\n) ORDER BY n",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
