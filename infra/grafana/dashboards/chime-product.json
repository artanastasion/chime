    {
      "type": "timeseries",
      "title": "Plays and outcomes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(occurred_at) AS time,\n       event_type AS outcome,\n       count() AS events\nFROM fact_app_events\nWHERE event_type IN ('play_start', 'play_complete', 'play_skip') AND $__timeFilter(occurred_at)\nGROUP BY time, outcome\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "drawStyle": "line",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.outcome}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
