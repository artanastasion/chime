    {
      "type": "table",
      "title": "Top tracks",
      "description": "Served from the agg_track_daily AggregatingMergeTree rollup",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT c.title AS track, c.primary_artist AS artist, c.album_title AS album,\n       sum(a.plays) AS plays, uniqMerge(a.listeners) AS listeners,\n       round(sum(a.completes) / nullIf(sum(a.completes) + sum(a.skips), 0), 3) AS completion,\n       round(sum(a.listened_ms) / 1000) AS listened_s\nFROM agg_track_daily AS a\nINNER JOIN v_track_catalog AS c ON c.track_id = a.track_id\nWHERE a.day BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY track, artist, album\nORDER BY plays DESC\nLIMIT 15",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "completion"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "listened_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 10,
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 14
