          "rawSql": "SELECT c.primary_artist AS artist, sum(a.plays) AS plays, uniqMerge(a.listeners) AS listeners,\n       round(sum(a.listened_ms) / 1000) AS listened_s\nFROM agg_track_daily AS a\nINNER JOIN v_track_catalog AS c ON c.track_id = a.track_id\nWHERE a.day BETWEEN toDate($__fromTime) AND toDate($__toTime) AND c.primary_artist != ''\nGROUP BY artist\nORDER BY plays DESC\nLIMIT 15",
          "format": 1,
          "queryType": "table"
