    {
      "type": "timeseries",
      "title": "Change stream by operation",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ingested_at) AS time,\n       multiIf(op = 'd', 'delete', op = 'u', 'update', 'insert') AS operation,\n       count() AS changes\nFROM cdc_changelog\nWHERE $__timeFilter(ingested_at)\nGROUP BY time, operation\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "drawStyle": "bars",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.operation}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "insert"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
