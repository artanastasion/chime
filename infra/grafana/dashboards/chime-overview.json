    {
      "type": "table",
      "title": "Latest changes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT source_ts AS committed_at,\n       dateDiff('millisecond', source_ts, ingested_at) AS lag_ms,\n       source_table AS table,\n       multiIf(op = 'd', 'delete', op = 'u', 'update', op = 'r', 'snapshot', 'insert') AS operation,\n       coalesce(nullIf(JSONExtractString(payload, 'title'), ''), nullIf(JSONExtractString(payload, 'name'), ''),\n                nullIf(JSONExtractString(payload, 'object_key'), ''), nullIf(JSONExtractString(payload, 'asset_type'), ''),\n                nullIf(JSONExtractString(payload, 'role'), ''), nullIf(JSONExtractString(payload, 'email'), ''), '—') AS summary,\n       lsn\nFROM cdc_changelog\nWHERE $__timeFilter(ingested_at)\nORDER BY lsn DESC\nLIMIT 50",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lag_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
