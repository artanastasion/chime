          },
          "editorType": "sql",
          "rawSql": "SELECT source_table AS table,\n       countIf(op IN ('c','r')) AS inserts,\n       countIf(op = 'u') AS updates,\n       countIf(op = 'd') AS deletes\nFROM cdc_changelog\nWHERE $__timeFilter(ingested_at)\nGROUP BY source_table\nORDER BY inserts + updates + deletes DESC",
