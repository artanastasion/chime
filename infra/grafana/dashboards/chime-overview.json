    {
      "type": "stat",
      "title": "Replication lag p95",
      "description": "Commit in PostgreSQL → row visible in ClickHouse",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dwh"
          },
          "editorType": "sql",
          "rawSql": "SELECT quantileExact(0.95)(dateDiff('millisecond', source_ts, ingested_at)) FROM cdc_changelog WHERE op != 'r' AND $__timeFilter(ingested_at)",
          "format": 1,
          "queryType": "table"
        }
      ],
